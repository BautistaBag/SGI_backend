# Archivos y carpetas a ignorar en Git

# Entorno Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Variables de entorno (contienen credenciales)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Base de datos
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Base de datos local de desarrollo (si usas SQLite)
local.db

# Archivos de caché
.pytest_cache/
.coverage
htmlcov/

# Migraciones de Alembic (si las usas)
alembic/versions/*.pyc

# Node (si tienes frontend integrado)
node_modules/
package-lock.json
yarn.lock
